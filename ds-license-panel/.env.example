# DSS STUDIO LICENSE - PRODUCTION CONFIGURATION
# Copy these variables to Vercel Environment Variables.
# Never commit real secrets.

NODE_ENV=production
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# API Security
API_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Roblox Owner
OWNER_ROBLOX_USER_ID=9262435668

# Private Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your-private-vercel-blob-token

# Optional: Local database only
# PGSSLMODE=disable
