# Copy to your hosting provider's Environment Variables. Never commit real secrets.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
API_SECRET=replace-with-a-random-secret-at-least-32-characters-long
OWNER_ROBLOX_USER_ID=9262435668
BLOB_READ_WRITE_TOKEN=your-private-vercel-blob-token
# Optional: PGSSLMODE=disable only for a local database that does not use TLS.
